{
  "expo": {
    "name": "Motif 8",
    "slug": "motif8",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#12151F",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12151F"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Motif 8 uses your camera to take your daily progress photo. Photos are stored only on your device."
      }
    },
    "android": {
      "package": "com.motif8.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12151F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Motif 8 uses your camera to take your daily progress photo. Photos are stored only on your device."
        }
      ]
    ]
  }
}
